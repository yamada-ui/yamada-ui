{
  "$schema": "https://raw.githubusercontent.com/magi-ai/opencode-magi/main/schema.json",
  "language": "en",
  "mode": "multi",
  "github": { "owner": "yamada-ui", "repo": "yamada-ui" },
  "agents": {
    "refs": {
      "melchior": {
        "id": "Melchior",
        "account": "melchior-magi",
        "model": [
          { "id": "opencode-go/muse-spark-1.3-contributor", "variant": "high" }
        ]
      },
      "balthasar": {
        "id": "Balthasar",
        "account": "balthasar-magi",
        "model": [
          { "id": "opencode/glm-5.3-flash-free", "variant": "high" },
          { "id": "opencode-go/glm-5.3-flash", "variant": "high" }
        ]
      },
      "caspar": {
        "id": "Caspar",
        "account": "caspar-magi",
        "model": [{ "id": "opencode-go/claude-haiku-5-5", "variant": "high" }]
      },
      "hirotomoyamada": {
        "account": "hirotomoyamada",
        "model": [{ "id": "openai/gpt-6.1-sol-fast", "variant": "high" }],
        "author": {
          "name": "hirotomoyamada",
          "email": "hirotomo.yamada@avap.co.jp"
        }
      }
    },
    "permissions": { "webfetch": "allow", "websearch": "allow" }
  },
  "review": {
    "reviewers": [
      { "ref": "melchior" },
      { "ref": "balthasar" },
      { "ref": "caspar" }
    ],
    "merge": { "queue": true, "approvalPolicy": "unanimous" },
    "prompts": {
      "reviewGuidelines": ".agents/references/pr-review-guidelines.md"
    }
  },
  "merge": {
    "editor": { "ref": "hirotomoyamada" },
    "prompts": {
      "editGuidelines": ".agents/references/pr-edit-guidelines.md"
    },
    "automation": { "conflict": true, "merge": [[false, { "edited": true }]] }
  }
}
